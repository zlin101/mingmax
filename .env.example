# Application
MINGMAX_DEBUG=false
MINGMAX_HOST=0.0.0.0
MINGMAX_PORT=8000

# LLM Configuration
# Default is "mock" for local development without API keys.
# To use a real LLM, you MUST set MINGMAX_LLM_PROVIDER=openai_compatible
# along with the other LLM_* variables below.
# Just setting model/key/base_url without changing provider will NOT enable real LLM.
MINGMAX_LLM_PROVIDER=mock

# Required when MINGMAX_LLM_PROVIDER=openai_compatible:
MINGMAX_LLM_MODEL=mock
MINGMAX_LLM_API_KEY=
MINGMAX_LLM_BASE_URL=

# Wire API protocol: "chat_completions" or "responses"
MINGMAX_LLM_WIRE_API=chat_completions

# Timeout for LLM requests in seconds (production recommends 120)
MINGMAX_LLM_TIMEOUT_SECONDS=30
